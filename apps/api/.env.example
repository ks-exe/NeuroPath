# Copy to .env for local development. No real values belong in this file.
# Uncomment a line only to override the default.

# Not a secret. local | dev | staging | prod
ENVIRONMENT=local
# Not a secret. Highest delivered platform phase used by the transition engine.
PLATFORM_PHASE=1
# Secret in deployed environments (loaded from the secrets provider).
# DATABASE_URL=
# Not a secret. Used only when the AWS secrets backend is active.
# AWS_REGION=
# Not a secret. env | aws. Defaults to env when ENVIRONMENT=local, otherwise aws.
# SECRETS_BACKEND=
